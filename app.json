{
  "expo": {
    "name": "Veciyo",
    "slug": "veci",
    "scheme": "veciyo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/branding/logo-veciyo.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.veciyo.app",
      "buildNumber": "1",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "entitlements": {
        "aps-environment": "development"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/branding/logo-veciyo.png",
        "backgroundColor": "#F5B800"
      },
      "package": "com.veciyo.app",
      "versionCode": 6,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.BLUETOOTH_CONNECT"
      ]
    },
    "plugins": [
      [
        "onesignal-expo-plugin",
        {
          "mode": "development",
          "disableLocation": true
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/branding/logo-veciyo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F5B800"
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Veciyo usa la cámara para leer el QR de los huéspedes en portería.",
          "microphonePermission": "Veciyo usa el micrófono para hablar por el intercomunicador.",
          "recordAudioAndroid": true
        }
      ],
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      "./plugins/llamada-entrante"
    ],
    "owner": "oscarmpz",
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "OneSignalNotificationServiceExtension",
                  "bundleIdentifier": "com.veciyo.app.OneSignalNotificationServiceExtension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.veciyo.app.onesignal"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "7b0a9dc0-cf4c-4118-bc61-91c407635a19"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7b0a9dc0-cf4c-4118-bc61-91c407635a19",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "pruebas"
      }
    }
  }
}
