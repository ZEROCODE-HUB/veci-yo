{
  "expo": {
    "name": "Veciyo",
    "slug": "veci",
    "scheme": "veciyo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/branding/logo-veciyo.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.veciyo.app",
      "buildNumber": "1",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "entitlements": {
        "aps-environment": "development"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/branding/logo-veciyo.png",
        "backgroundColor": "#F5B800"
      },
      "package": "com.veciyo.app",
      "versionCode": 1
    },
    "plugins": [
      [
        "onesignal-expo-plugin",
        {
          "mode": "development",
          "disableLocation": true
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/branding/logo-veciyo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F5B800"
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Veciyo usa la cámara para leer el QR de los huéspedes en portería.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "owner": "nocodehero",
    "extra": {
      "eas": {
        "projectId": "b09b0e34-a30f-48a6-8601-21ce41e804ee"
      }
    }
  }
}
