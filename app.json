{
  "expo": {
    "name": "Veciyo",
    "slug": "veci",
    "scheme": "veciyo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/branding/logo-veciyo.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.veciyo.app",
      "buildNumber": "1",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSPhotoLibraryUsageDescription": "Veciyo usa tus fotos para adjuntarlas a un chat, a la correspondencia o a un reclamo. Solo se sube la foto que eliges.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "aps-environment": "production"
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/branding/logo-veciyo.png",
        "backgroundColor": "#F5B800"
      },
      "package": "com.veciyo.app",
      "versionCode": 8,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.BLUETOOTH_CONNECT"
      ]
    },
    "plugins": [
      [
        "onesignal-expo-plugin",
        {
          "mode": "production",
          "disableLocation": true
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/branding/logo-veciyo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F5B800"
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Veciyo usa la cámara en portería para leer el QR de los huéspedes y comprobar su documento de identidad. La foto del documento se lee en el celular y no se guarda.",
          "microphonePermission": "Veciyo usa el micrófono para hablar por el intercomunicador.",
          "recordAudioAndroid": true
        }
      ],
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      "./plugins/llamada-entrante"
    ],
    "owner": "nocodehero",
    "extra": {
      "eas": {
        "projectId": "b09b0e34-a30f-48a6-8601-21ce41e804ee"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b09b0e34-a30f-48a6-8601-21ce41e804ee",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
