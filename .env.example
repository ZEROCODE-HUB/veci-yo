# Copiar a .env.local y completar. .env.local está en .gitignore.

# ── Cliente (se empaquetan en la app; públicos por diseño, protegidos por RLS) ──
EXPO_PUBLIC_SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── Solo servidor / migraciones. NUNCA con prefijo EXPO_PUBLIC_ ──
# service_role ignora por completo las políticas RLS.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# ── Invitaciones ──
# Envio real del correo de invitacion. APAGADO durante el desarrollo: sin acceso
# a la bandeja no se podria recuperar el enlace y el flujo no seria probable.
# Con la bandera apagada, la app muestra el enlace en pantalla.
EXPO_PUBLIC_INVITACIONES_EMAIL=false

# Base del enlace que se manda por correo.
EXPO_PUBLIC_WEB_URL=https://veciyo-web.vercel.app

# Pagina web donde se cobra la suscripcion de renta corta.
#
# El KT del 17/07/2026 decide que el cobro se hace **fuera de la app**, para
# evitar la comision del 15% que Apple y Google cobran sobre las compras
# in-app de productos digitales.
#
# Todavia no hay pasarela contratada. Mientras esta variable este vacia, la
# pantalla de suscripcion ofrece un paso simulado, etiquetado como "modo de
# pruebas", que activa la suscripcion sin cobrar y sin referencia de pago.
# En cuanto exista la pasarela, se define aqui y la app manda a la web sin
# tocar codigo.
EXPO_PUBLIC_URL_PAGO_SUSCRIPCION=
