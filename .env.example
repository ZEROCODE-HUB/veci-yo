# Copiar a .env.local y completar. .env.local está en .gitignore.

# ── Cliente (se empaquetan en la app; públicos por diseño, protegidos por RLS) ──
EXPO_PUBLIC_SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── Solo servidor / migraciones. NUNCA con prefijo EXPO_PUBLIC_ ──
# service_role ignora por completo las políticas RLS.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
